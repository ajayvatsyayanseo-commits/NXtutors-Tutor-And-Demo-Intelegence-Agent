# Copy to <env>.tfvars. Contains no secrets — only references.
environment           = "dev"
artifact_bucket       = "nxtutors-lambda-artifacts"
artifact_key          = "tutor-match-meta/REPLACE_WITH_GIT_SHA.zip"
secret_name           = "/tutor-match-meta/dev"
alarm_topic_arns      = ["arn:aws:sns:ap-south-1:REPLACE:nxtutors-alerts"]

# The RDS instance the connection alarm watches. An instance identifier, not a
# proxy name: there is no RDS Proxy any more, so each concurrent Lambda holds
# its own connection and the instance's own counter is where exhaustion shows.
db_instance_identifier = "database-1"
