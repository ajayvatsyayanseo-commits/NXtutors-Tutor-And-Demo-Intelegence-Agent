# Phase 2 build artifacts ? the Lambda package is built, never committed.
dist/
requirements.audit.txt
requirements.lambda.txt

# Terraform: state never enters the repository. See
# docs/operations/terraform-state.md for the backend decision.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/backend.hcl
infra/terraform/*.tfvars
infra/terraform/tfplan
infra/terraform/plan.json
