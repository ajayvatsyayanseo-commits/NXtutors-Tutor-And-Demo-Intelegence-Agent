# tutor-match-meta — every supported setting.
#
# GENERATED by scripts/sync_env_example.py from config/settings.py.
# Do not edit by hand: add the field to Settings and re-run the script.
# `make check` fails when this file is out of date.
#
# Secrets are blank on purpose. This file is committed.


# --- runtime and network placement
TMM_DEFAULT_TIMEZONE=Asia/Kolkata
TMM_ENVIRONMENT=local
TMM_LOG_LEVEL=INFO
TMM_NETWORK_ZONE=all
TMM_SERVICE_NAME=tutor-match-meta

# --- postgres — the system of record
TMM_POSTGRES_DSN=
TMM_POSTGRES_MAX_OVERFLOW=0
TMM_POSTGRES_POOL_SIZE=5
TMM_POSTGRES_REQUIRE_TLS=true
TMM_POSTGRES_SCHEMA=tutor_match
TMM_POSTGRES_STATEMENT_TIMEOUT_MS=5000

# --- handoff with lead intake
TMM_ACCOUNT_REQUIRED_FOR_MATCH=false
TMM_CONTINUATION_SIGNING_KEY=
TMM_CONTINUATION_TTL_SECONDS=21600
TMM_INTERNAL_SECRET=
TMM_OUTBOUND_OWNERSHIP=caller_sends

# --- rollout flags
TMM_FLAG_ALWAYS_ON_REFS=
TMM_FLAG_AUTO_DEMO_ENABLED=false
TMM_FLAG_ENABLED=false
TMM_FLAG_LLM_ENABLED=false
TMM_FLAG_MEMORY_ENABLED=false
TMM_FLAG_PERCENTAGE_ROLLOUT=0
TMM_FLAG_RAG_ENABLED=false
TMM_FLAG_SHADOW_MODE=true
TMM_FLAG_WRITEBACK_ENABLED=false

# --- security and rate limits
TMM_HASH_PEPPER=
TMM_INGRESS_MAX_BODY_BYTES=65536
TMM_INGRESS_SIGNING_KEY=
TMM_INGRESS_TIMESTAMP_TOLERANCE_SECONDS=300
TMM_RATE_LIMIT_GLOBAL_PER_MINUTE=600
TMM_RATE_LIMIT_LLM_PER_CONVERSATION_PER_MINUTE=4
TMM_RATE_LIMIT_PER_CALLER_PER_MINUTE=600
TMM_RATE_LIMIT_PER_CONVERSATION_PER_MINUTE=12
TMM_RATE_LIMIT_PER_IDENTITY_PER_MINUTE=20
TMM_RATE_LIMIT_WEBSITE_WRITE_PER_MINUTE=30

# --- website read (signed HTTPS tutor feed)
TMM_TUTOR_FEED_PAGE_SIZE=100
TMM_TUTOR_FEED_TIMEOUT_SECONDS=15.0
TMM_WEBSITE_API_BASE_URL=
TMM_WEBSITE_API_SIGNING_KEY=
TMM_WEBSITE_API_TIMEOUT_SECONDS=8.0

# --- website write-back
TMM_WEBSITE_WRITE_ENABLED=false

# --- chitragupta memory
TMM_CHITRAGUPTA_AGENT_ID=tutor-match-meta
TMM_CHITRAGUPTA_API_KEY=
TMM_CHITRAGUPTA_BASE_URL=
TMM_CHITRAGUPTA_ENABLED=false
TMM_CHITRAGUPTA_TIMEOUT_SECONDS=3.0

# --- whatsapp outbound
TMM_WHATSAPP_ACCESS_TOKEN=
TMM_WHATSAPP_API_VERSION=v21.0
TMM_WHATSAPP_ENABLED=false
TMM_WHATSAPP_PHONE_NUMBER_ID=

# --- llm provider and model routing
TMM_LLM_MAX_OUTPUT_TOKENS=
TMM_LLM_MAX_RETRIES=2
TMM_LLM_PROVIDER=stub
TMM_LLM_STORE_RESPONSES=false
TMM_LLM_TIER1_MODEL=gpt-4o-mini
TMM_LLM_TIER2_MODEL=gpt-4o
TMM_LLM_TIMEOUT_SECONDS=12.0
TMM_MODEL_EMBEDDING=text-embedding-3-small
TMM_MODEL_ESCALATION=
TMM_MODEL_EXPLANATION=
TMM_MODEL_EXTRACTION=
TMM_OPENAI_API_KEY=
TMM_OPENAI_BASE_URL=

# --- token and call budgets
TMM_LLM_CONVERSATION_TOKEN_BUDGET=
TMM_LLM_MAX_CALLS_PER_CONVERSATION=12
TMM_LLM_MAX_CALLS_PER_TURN=2
TMM_LLM_MAX_ESCALATIONS_PER_CONVERSATION=1
TMM_RAG_TOKEN_BUDGET=
TMM_RAG_TOP_K=5

# --- aws
TMM_ANALYTICS_BUCKET=
TMM_AWS_REGION=ap-south-1
TMM_ENRICH_QUEUE_URL=
TMM_MATCH_QUEUE_URL=
TMM_OUTBOUND_QUEUE_URL=
TMM_SECRETS_PREFIX=

# --- cache and kill switches
TMM_CACHE_BACKEND=postgres
TMM_CACHE_DEFAULT_TTL_SECONDS=300
TMM_KILL_SWITCH_TTL_SECONDS=10

# --- geocoding
TMM_GEOCODE_CACHE_TTL_SECONDS=86400
TMM_GEOCODE_MAX_CALLS_PER_TURN=1
TMM_GEOCODER=offline
TMM_GEOCODER_API_KEY=
TMM_GEOCODER_BASE_URL=
TMM_GEOCODER_TIMEOUT_SECONDS=3.0

# --- scoring policy and freshness
TMM_DEFAULT_POLICY=regular_school_support.v1
TMM_POLICY_DIR=config\policies
TMM_PROJECTION_AGING_HOURS=24
TMM_PROJECTION_FRESH_HOURS=6

# --- analytics
TMM_ANALYTICS_ENABLED=true
TMM_ANALYTICS_INCLUDE_RAW_TEXT=false

# --- public links
TMM_WEBSITE_PUBLIC_BASE_URL=https://www.nxtutors.com

# --- other (unclassified: add a group in sync_env_example.py)
TMM_FEED_STAGING_PREFIX=feed-staging/
